{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Katraineo",
  "version": "2.0.0",
  "identifier": "io.github.yongjer.katraineo",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Katraineo",
        "width": 1400,
        "height": 900,
        "minWidth": 960,
        "minHeight": 620
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; img-src 'self' data: asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; font-src 'self' data:; media-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "BoardGame",
    "shortDescription": "Go analysis and training with KataGo",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../resources/models/b10c384h6nbttflrs.bin.gz": "models/b10c384h6nbttflrs.bin.gz",
      "../resources/KataGo/analysis_config.cfg": "KataGo/analysis_config.cfg"
    }
  }
}
